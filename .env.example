# Public origin. Set to the final HTTPS origin in production (currently
# https://vow-motion.vercel.app). Drives email links, sitemap, and unsubscribe URLs.
APP_URL=http://localhost:3000
# Omit for single-process embedded PostgreSQL in ./data/postgres.
DATABASE_URL=
DATA_DIR=./data
# Private Vercel Blob store; use OIDC store ID or a server-only read/write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Messaging is a development outbox unless these are configured. Only needed once
# a real wedding is sending guest mail; see docs/EMAIL-SETUP-RUNBOOK.md (parked).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
RESEND_API_KEY=
EMAIL_FROM=Vow Motion <invitations@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Hosted one-time Stripe Checkout. Create prices in your Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_SIGNATURE=
STRIPE_PRICE_BESPOKE=
# Worker / internal operations; generate cryptographically random secrets.
CRON_SECRET=
# Signs stateless one-click unsubscribe links. Falls back to CRON_SECRET if unset;
# rotating it invalidates every unsubscribe link already in a guest's inbox, so
# set it once and leave it. CASL expects the link to work for 60 days after sending.
UNSUBSCRIBE_SECRET=
ADMIN_EMAILS=
# Optional custom-domain automation boundary.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
