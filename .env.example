# Public origin. Set to the final HTTPS origin in production (currently
# https://vow-motion.vercel.app). Drives email links, sitemap, and unsubscribe URLs.
APP_URL=http://localhost:3000
# Rate limiting keys requests by client IP from the x-forwarded-for header,
# which is trusted automatically on Vercel (its edge overwrites any
# client-supplied value) but is otherwise just whatever the client sends.
# Set TRUST_PROXY=true only if you deploy behind your own reverse proxy
# (nginx, Caddy, a load balancer) that is configured to strip inbound
# client-supplied x-forwarded-for and set its own. Leave unset for local dev
# or a directly-exposed self-hosted install — every rate-limited action then
# shares one bucket instead of trusting a spoofable per-request claim.
TRUST_PROXY=
# Omit for single-process embedded PostgreSQL in ./data/postgres.
DATABASE_URL=
DATA_DIR=./data
# Private Vercel Blob store; use OIDC store ID or a server-only read/write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Messaging is a development outbox unless these are configured. Only needed once
# a real wedding is sending guest mail; see docs/EMAIL-SETUP-RUNBOOK.md (parked).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
RESEND_API_KEY=
EMAIL_FROM=Vow Motion <invitations@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Hosted one-time Stripe Checkout. Create prices in your Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_SIGNATURE=
STRIPE_PRICE_BESPOKE=
# Worker / internal operations; generate cryptographically random secrets.
CRON_SECRET=
# Signs stateless one-click unsubscribe links. Falls back to CRON_SECRET if unset;
# rotating it invalidates every unsubscribe link already in a guest's inbox, so
# set it once and leave it. CASL expects the link to work for 60 days after sending.
UNSUBSCRIBE_SECRET=
ADMIN_EMAILS=
# Brand Instagram publishing from /admin/content. See docs/INSTAGRAM-SETUP.md.
# ACCOUNT_ID is the Instagram-scoped user id; ACCESS_TOKEN is the long-lived
# token (the worker refreshes it from here into the social_tokens table).
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Optional custom-domain automation boundary.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# The operator's real legal identity, shown on /privacy once set. Code cannot
# supply these — they are facts about the business operating this deployment.
# Leave unset and the privacy page says so plainly instead of guessing.
# See docs/LEGAL-CHECKLIST.md before accepting real guest data.
OPERATOR_LEGAL_NAME=
OPERATOR_JURISDICTION=
OPERATOR_ADDRESS=
OPERATOR_PRIVACY_CONTACT=
OPERATOR_PRIVACY_POLICY_URL=
OPERATOR_TERMS_URL=
